# --- PostgreSQL ---
POSTGRES_USER=cpms_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cpms_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy connection string (used directly by the backend)
DATABASE_URL=postgresql+psycopg2://cpms_user:change_me@db:5432/cpms_db

# --- Auth / JWT ---
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_STORAGE_DIR=./uploaded_files

# --- Optional: bootstrap an initial Admin user on first `python -m app.scripts.seed` ---
# Leave blank to skip; you can always register the first user via POST /api/auth/register instead.
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
